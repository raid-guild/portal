# Database connection string
DATABASE_URI=postgres://postgres:postgres@localhost:5432/<your-db-name>

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional read-only origin for a volume-less preview to serve existing uploads.
# Use the old Portal service's stable Railway hostname, not portal.raidguild.org;
# that custom domain will point at the new service after DNS moves.
MEDIA_FALLBACK_ORIGIN=

# Set only after the old volume's media has been copied to the shared Railway
# bucket. Both Portal services can use the same bucket and portal/media prefix.
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Set true only if your S3 endpoint requires path-style bucket URLs.
MEDIA_S3_FORCE_PATH_STYLE=false
# Short cutover gate: stop media mutations on both services while final files
# are copied. Existing media reads and other CMS edits continue.
MEDIA_UPLOADS_PAUSED=false

# Optional comma-separated exact HTTPS origins accepted by Post interactive embeds.
# Defaults to the RaidGuild artifact production and custom domains.
INTERACTIVE_ARTIFACT_ORIGINS=https://artifacts.raidguild.org,https://portal-artifacts-production.up.railway.app

# Optional shared secret for machine account self-registration at /api/agent/register.
# Leave unset to disable agent self-registration.
AGENT_REGISTRATION_SECRET=

# Public inquiry intake (typed and legacy sponsor). Enforced by default.
# Missing/invalid configuration fails closed. See docs/inquiry-protection.md.
INQUIRY_PROTECTION_MODE=enforce
NEXT_PUBLIC_INQUIRY_PROTECTION_MODE=enforce
# Public values are compiled into the frontend; set before building.
NEXT_PUBLIC_INQUIRY_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames (no schemes or paths).
TURNSTILE_ALLOWED_HOSTNAMES=
# Independent private random secret, at least 32 characters, shared by replicas.
INQUIRY_RATE_LIMIT_SECRET=
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600
INQUIRY_RATE_LIMIT_IP_MAX=10
INQUIRY_RATE_LIMIT_EMAIL_MAX=3
# Optional single-IP header, overwritten by trusted ingress. Keep empty unless
# direct origin access is blocked. Forwarded IP lists are not accepted.
# Without a trusted IP, requests share the unknown-IP bucket.
INQUIRY_TRUSTED_IP_HEADER=

# Optional Prism hook integration for Infinite Wiki topic expansion.
# PRISM_AGENT_API_BASE_URL should point at the Prism site service root, not the memory service.
PRISM_AGENT_API_BASE_URL=
PRISM_AGENT_SERVICE_TOKEN=
PRISM_WIKI_TOPIC_EXPAND_HOOK_KEY=wiki-topic-expand
PRISM_WIKI_ARTICLE_GENERATE_HOOK_KEY=wiki-article-generate

# Optional SendGrid SMTP email delivery for password resets and other Payload emails.
EMAIL_FROM_ADDRESS=noreply@raidguild.org
EMAIL_FROM_NAME="RaidGuild Portal"
SENDGRID_API_KEY=

# Optional Newsletter module integration. Sends Portal post drafts to listmonk.
LISTMONK_URL=https://updates.raidguild.org
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_TEMPLATE_ID=
LISTMONK_DEFAULT_LIST_IDS=
LISTMONK_FROM_EMAIL="RaidGuild <updates@updates.raidguild.org>"
NEWSLETTER_DEFAULT_TEST_EMAIL=
